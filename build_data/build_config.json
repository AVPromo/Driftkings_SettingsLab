  },
  "python": {
    "version": "2.7",
    "source_root": "mod/res/scripts/client",
    "staging_root": "build/staging/res/scripts/client",
    "archive_root": "res/scripts/client",
    "include": [
      "**/*.py"
    ],
    "entrypoint": "gui/mods/mod_Driftkings.py",
    "component_list": "Driftkings/component_list.py",
    "optimize": 0
  },
  "assets": {
    "exclude": [
      "**/README.md",
      "**/__pycache__/**",
      "**/*.pyc",
      "**/*.bak"
    ]
  },
  "defaults": {
    "source_root": "res/configs/Driftkings",
    "install_root": "mods/configs/Driftkings",
    "include": [
      "load.json",
      "default/**/*.json"
    ],
    "install_policy": "missing_only",
    "in_wotmod": false
  },
  "ui_dependencies": {
    "directory": "res/wotmods",
    "files": [
      {
        "name": "me.poliroid.modslistapi_1.8.0.wotmod",
        "sha256": "c6e4a1d9476b0195c3b4fab392cf5d68c00f1d02fd79e29bd7424ebda88b498c"
      },
      {
        "name": "net.openwg.gameface_1.2.2.wotmod",
        "sha256": "2bb65f28663e3ab34b5a1102a1bbd1f6e17a65e1f6a898a8645c4ab732b50184"
      }
    ]
  },
  "generators": {
